<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 语音优先输入：麦克风「按住说话」 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 高清屏幕采集(MediaProjection)前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- LAN 设备发现：UDP 广播/组播需要持有 multicast 锁 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- VPN 代理能力(社区插件可调用的 start_vpn 工具):BIND_VPN_SERVICE 是系统权限,
         由 ClawVpnService 的 android:permission 声明供系统 bind 时校验,App 不能也无需
         uses-permission 它(否则 lint ProtectedPermissions 报错)。 -->

    <!-- Path A: 个人上下文能力（短信 / 日历 / 使用统计）-->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- 接收短信(验证码自动复制等主动规则);需运行时授予,默认功能关闭 -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Device features -->
    <!-- 触摸屏非必须（兼容 TV 盒子） -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />
    <!-- Leanback 支持（Android TV 桌面显示） -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- 电话功能非必须（TV 盒子无 SIM 卡） -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".ClawApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.OctopusMobile">

        <!-- 启动页（去掉竖屏锁定，TV 需要横屏） -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.OctopusMobile.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- 响应系统助理入口(长按 Home / 电源键长按 / 默认助手 App)。
                 Android 12+ 用户可在「设置 → 系统 → 默认助理 App」选 Octopus,
                 长按 Home 即可直启 Octopus 主界面,与系统 Assistant / Google Gemini 平级。
                 注:此 intent-filter 仅声明响应,不强制接管;用户需在系统设置主动选 Octopus 才生效。 -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.systemui.assist.handler"
                android:value="1" />
        </activity>


        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.compose.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.OctopusMobile" />

        <activity
            android:name=".ui.guide.GuideActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.account.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.account.AccountActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.LlmConfigActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.ChannelConfigActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.RuntimeConfigActivity"
            android:exported="false" />
        <activity
            android:name=".ui.device.DeviceListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.device.DeviceDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.device.RemoteControlActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".ui.browser.BrowserActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- 接管 http/https 链接(可被设为系统默认浏览器) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- 响应系统搜索意图(长按 Home → 搜索 / Assistant 文字搜索) -->
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.cast.ScreenCastActivity"
            android:exported="false" />
        <activity
            android:name=".ui.plugin.PluginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.web.WebActivity"
            android:exported="false" />

        <!-- 发现页功能界面（深色 Compose） -->
        <activity android:name=".ui.featurescreens.MemoryActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.EvolutionActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.MultiWindowActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.VideoLibraryActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.CloudDriveActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.TrustCenterActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.ChannelAclActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.AuditLogActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.ActivityActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.RoutinesActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.UserscriptStoreActivity" android:exported="false" />
        <activity
            android:name=".plugin.MiniAppActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 横屏「桌面模式」:左浏览器桌面 + 右对话。锁横屏 + configChanges 防旋转 recreate 闪断 WebView -->
        <activity
            android:name=".ui.desktop.DesktopActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ui.voice.VoiceCallActivity" android:exported="false" />
        <activity android:name=".ui.voice.VoiceSettingsActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.MiniAppListActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.MiniAppMarketplaceActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.SkillsActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.McpServersActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.PersonasActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.WorkflowsActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.ChannelsActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.WeChatLoginActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.BrowserSettingsActivity" android:exported="false" />
        <activity android:name=".ui.featurescreens.PcRemoteActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".ui.featurescreens.PcRemoteWebrtcActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- mpv 播放界面：横屏 + 全屏 + D-pad 支持 -->
        <activity
            android:name=".media.PlayerActivity"
            android:exported="false"
            android:excludeFromRecents="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".tool.impl.ClipboardReaderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Transparent" />

        <service
            android:name=".service.ClawAccessibilityService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Accessibility automation service for remote device control" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku Provider —— shell 级权限增强入口 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".service.ForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps remote-control and accessibility automation alive in the background" />
        </service>

        <!-- 高清屏幕采集:MediaProjection 前台服务 + 透明授权中转 Activity -->
        <service
            android:name=".capture.ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".capture.MediaProjectionRequestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 定时守护 -->
        <service
            android:name=".service.KeepAliveJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 开机自启动 -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 例程定时闹钟接收器（显式 Intent，无需 intent-filter） -->
        <receiver
            android:name=".service.RoutineAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 桌面小组件(4x1 横条:logo + 标题 + 语音/浏览器快捷按钮)。
             用户长按桌面 → 添加 widget → 选 "Octopus Mobile" 即可。
             注册需声明 APPWIDGET_BIND 权限(系统在用户主动添加时授予)。 -->
        <receiver
            android:name=".service.OctopusAppWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/octopus_widget_info" />
        </receiver>

        <!-- 短信接收（验证码自动复制等主动规则）；android:permission 限定仅系统可投递此广播 -->
        <receiver
            android:name=".octopus_mobile.proactive.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 投屏确认通知操作接收器（显式 Intent，exported=false） -->
        <receiver
            android:name=".cast.CastApprovalReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 通知监听服务（主动 Agent） -->
        <service
            android:name=".octopus_mobile.proactive.NotificationRelayService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- VPN 代理隧道服务（start_vpn 工具的后端引擎，SOCKS5 转发） -->
        <service
            android:name=".service.ClawVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="SOCKS5 proxy tunnel for user-generated automation plugins" />
        </service>

        <!-- VPN 系统授权中转 Activity（透明无界面，仅拉起系统 VPN 授权弹窗） -->
        <activity
            android:name=".service.VpnPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>
