<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 应用主题 - 浅色 -->
    <style name="Theme.OctopusMobile" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/colorBrandPrimary</item>
        <item name="colorOnPrimary">@color/colorBrandOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorBrandContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorBrandOnContainer</item>

        <!-- Secondary = Echo Core (selection, checked controls), tertiary = warning. Unset, framework
             CheckBox / RadioButton / Switch fall back to the Material baseline purple (#625B71). -->
        <item name="colorSecondary">@color/colorSuccessPrimary</item>
        <item name="colorOnSecondary">@color/colorSuccessOnPrimary</item>
        <item name="colorSecondaryContainer">@color/colorSuccessContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorSuccessOnContainer</item>
        <item name="colorTertiary">@color/colorWarningPrimary</item>
        <item name="colorOnTertiary">@color/colorWarningOnPrimary</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/colorBgPrimary</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>
        <item name="colorSurface">@color/colorContainerBrighten</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorSurfaceVariant">@color/colorContainerBase</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>

        <!-- Outline -->
        <item name="colorOutline">@color/colorBorderBase</item>
        <item name="colorOutlineVariant">@color/colorBorderLow</item>

        <!-- Error colors -->
        <item name="colorError">@color/colorErrorPrimary</item>
        <item name="colorOnError">@color/colorErrorOnPrimary</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/colorBgPrimary</item>
        <item name="android:statusBarColor">@color/colorBgPrimary</item>
        <item name="android:navigationBarColor">@color/colorBgPrimary</item>
    </style>

    <!-- ic_launcher 圆角样式 -->
    <!-- 大图标（80pt）：16pt 圆角 -->
    <style name="ShapeAppearance.Launcher.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16pt</item>
    </style>
    <!-- 中图标（40pt）：8pt 圆角 -->
    <style name="ShapeAppearance.Launcher.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8pt</item>
    </style>
    <!-- 小图标（24pt）：4pt 圆角 -->
    <style name="ShapeAppearance.Launcher.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4pt</item>
    </style>
    <!-- 圆形裁剪 -->
    <style name="ShapeAppearance.Launcher.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 启动页专用主题：ECHO 冷启动窗口始终是 Graphite 底 + 标志（不随浅色/深色切换），无白屏 -->
    <style name="Theme.OctopusMobile.Splash" parent="Theme.OctopusMobile">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/echo_ground_graphite</item>
        <item name="android:navigationBarColor">@color/echo_ground_graphite</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ 系统 SplashScreen：Graphite 底 + ECHO 标志（自适应图标前景，108dp 网格） -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_echo_foreground</item>
        <item name="android:windowSplashScreenBackground">@color/echo_ground_graphite</item>
    </style>

    <!-- 透明 Activity（用于剪贴板读取等需要前台焦点的操作） -->
    <style name="Theme.Transparent" parent="android:Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- 对话框样式 -->
    <style name="DialogStyle" parent="android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- 更新弹窗样式（从底部弹出） -->
    <style name="UpdateDialogStyle" parent="android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/UpdateDialogAnimation</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- 底部弹出动画 -->
    <style name="UpdateDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>
</resources>
