<?xml version="1.0" encoding="utf-8"?>
<!-- Octopus 桌面小组件配置。
     - minWidth/minHeight:遵循 Material Design widget guideline,4x1 = 250x40dp
     - updatePeriodMillis:0 = 不自动更新(由 AppWidgetProvider 按需触发,省电)
     - previewImage:用 ic_launcher 作为预览图(简化,后续可换专门预览图)
     - initialLayout:widget_layout.xml
     - resizeMode:horizontal 横向拉伸(适配 4x1 / 5x1) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:updatePeriodMillis="0"
    android:previewImage="@drawable/ic_launcher"
    android:initialLayout="@layout/widget_octopus_quick"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:targetCellWidth="4"
    android:targetCellHeight="1" />
