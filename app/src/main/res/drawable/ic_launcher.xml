<?xml version="1.0" encoding="utf-8"?>
<!-- ECHO app icon as one vector: the Graphite rounded tile with the snow mark and cyan Echo Core
     (analysis/echo-brand-kit/svg/echo-app-icon.svg, 1024 → 108 units). The launcher uses the adaptive
     @mipmap/ic_launcher; this tile is what splash, login, floating window and widget show. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tile: Graphite, corner radius 22.5% -->
    <path android:pathData="M24.2578,0 H83.7422 A24.2578,24.2578 0,0 1,108 24.2578 V83.7422 A24.2578,24.2578 0,0 1,83.7422 108 H24.2578 A24.2578,24.2578 0,0 1,0 83.7422 V24.2578 A24.2578,24.2578 0,0 1,24.2578 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108">
                <item android:offset="0" android:color="#1B1F25" />
                <item android:offset="1" android:color="#0B0D10" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hairline edge (white 7%) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#12FFFFFF"
        android:strokeWidth="0.421875"
        android:pathData="M24.258,0.84375 H83.742 A23.414,23.414 0,0 1,107.15625 24.258 V83.742 A23.414,23.414 0,0 1,83.742 107.15625 H24.258 A23.414,23.414 0,0 1,0.84375 83.742 V24.258 A23.414,23.414 0,0 1,24.258 0.84375 Z" />

    <!-- Mark on the 64-unit brand grid, scaled to the tile (108 / 64) -->
    <group
        android:scaleX="1.6875"
        android:scaleY="1.6875">
        <!-- Core glow -->
        <path android:pathData="M28.625,32a9.375,9.375 0,1 0,18.75 0a9.375,9.375 0,1 0,-18.75 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="38"
                    android:centerY="32"
                    android:gradientRadius="9.375">
                    <item android:offset="0" android:color="#596FE3F0" />
                    <item android:offset="1" android:color="#006FE3F0" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Frame -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#EEF1F4"
            android:strokeWidth="6"
            android:strokeLineCap="butt"
            android:pathData="M50,17H24a7,7 0,0 0,-7 7v16a7,7 0,0 0,7 7h26" />
        <!-- Echo Core -->
        <path
            android:fillColor="#6FE3F0"
            android:pathData="M33,32a5,5 0,1 0,10 0a5,5 0,1 0,-10 0z" />
    </group>
</vector>
