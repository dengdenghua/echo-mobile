<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: the ECHO mark (snow frame + cyan Echo Core) on a transparent 108dp canvas.
     The mark is drawn on the brand's 64-unit grid (echo-mark-core.svg, bbox 14..50) and scaled 10/9 around
     the canvas centre: 40dp wide, i.e. 56% of the 72dp visible icon like echo-app-icon.svg, well inside the
     66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.1111111"
        android:scaleY="1.1111111"
        android:translateX="18.444444"
        android:translateY="18.444444">
        <!-- Core glow, as on echo-app-icon.svg -->
        <path android:pathData="M28.625,32a9.375,9.375 0,1 0,18.75 0a9.375,9.375 0,1 0,-18.75 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="38"
                    android:centerY="32"
                    android:gradientRadius="9.375">
                    <item android:offset="0" android:color="#596FE3F0" />
                    <item android:offset="1" android:color="#006FE3F0" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Frame -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#EEF1F4"
            android:strokeWidth="6"
            android:strokeLineCap="butt"
            android:pathData="M50,17H24a7,7 0,0 0,-7 7v16a7,7 0,0 0,7 7h26" />
        <!-- Echo Core -->
        <path
            android:fillColor="#6FE3F0"
            android:pathData="M33,32a5,5 0,1 0,10 0a5,5 0,1 0,-10 0z" />
    </group>
</vector>
