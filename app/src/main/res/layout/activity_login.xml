<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="88dp"
            android:paddingBottom="32dp">

            <!-- 品牌 Hero -->
            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:contentDescription="@string/browser_brand_name"
                android:src="@drawable/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.02"
                android:text="@string/browser_brand_name"
                android:textColor="@color/colorBrandPrimary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/account_login_tip"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <!-- 表单玻璃卡 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                app:cardBackgroundColor="@color/colorContainerBrighten"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/tvTabEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_tab_email"
                            android:textColor="@color/colorBrandPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTabPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="@string/account_tab_phone"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/colorBgSecondary"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <EditText
                            android:id="@+id/etMobile"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@null"
                            android:hint="@string/account_email_hint"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:paddingHorizontal="16dp"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textColorHint="@color/colorTextTertiary"
                            android:textSize="15sp" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/account_code_label"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/colorBgSecondary"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etCode"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@null"
                                android:hint="@string/account_code_hint"
                                android:inputType="number"
                                android:maxLines="1"
                                android:paddingHorizontal="16dp"
                                android:singleLine="true"
                                android:textColor="@color/colorTextPrimary"
                                android:textColorHint="@color/colorTextTertiary"
                                android:textSize="15sp" />
                        </androidx.cardview.widget.CardView>

                        <com.apk.claw.android.widget.KButton
                            android:id="@+id/btnSendCode"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_marginStart="10dp"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="@string/account_send_code"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.apk.claw.android.widget.KButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="26dp"
                        android:gravity="center"
                        android:text="@string/account_login_button"
                        android:textSize="16sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 「不登录使用」:仅启动闸显示。本地模式:对话(自配模型)、模型设置、连接自己的 Echo。 -->
            <TextView
                android:id="@+id/btnUseLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/account_local_mode_use"
                android:textColor="@color/colorBrandPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLocalHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="8dp"
                android:text="@string/account_local_mode_hint"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- 返回（仅非强制进入时显示；强制登录时隐藏） -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="40dp"
        android:contentDescription="@string/cd_back"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        app:tint="@color/colorTextPrimary" />
</FrameLayout>
